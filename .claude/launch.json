{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "screener",
      "runtimeExecutable": ".venv/Scripts/python.exe",
      "runtimeArgs": [
        "-m",
        "streamlit",
        "run",
        "frontend/streamlit_app.py",
        "--server.headless",
        "true",
        "--server.port",
        "8501",
        "--browser.gatherUsageStats",
        "false"
      ],
      "port": 8501
    },
    {
      "name": "screener-8502",
      "runtimeExecutable": ".venv/Scripts/python.exe",
      "runtimeArgs": [
        "-m",
        "streamlit",
        "run",
        "frontend/streamlit_app.py",
        "--server.headless",
        "true",
        "--server.port",
        "8502",
        "--browser.gatherUsageStats",
        "false"
      ],
      "port": 8502
    },
    {
      "name": "market-desk",
      "runtimeExecutable": ".venv/Scripts/python.exe",
      "runtimeArgs": [
        "-m",
        "streamlit",
        "run",
        "market_desk/app.py",
        "--server.headless",
        "true",
        "--server.port",
        "8503",
        "--browser.gatherUsageStats",
        "false"
      ],
      "port": 8503
    },
    {
      "name": "chart-api",
      "runtimeExecutable": ".venv/Scripts/python.exe",
      "runtimeArgs": [
        "-m",
        "uvicorn",
        "backend.api.app:app",
        "--port",
        "8010",
        "--reload",
        "--reload-dir",
        "backend"
      ],
      "port": 8010
    }
  ]
}