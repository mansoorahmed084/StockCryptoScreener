# Copy to .env and fill in. Public market data needs NO keys.
# These are only needed for future private (order/balance) calls or alerts.

# Telegram alerts (Phase 3+)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# CoinDCX API key for the Trade page / `backend.cli trade` (INR futures).
# CoinDCX keys have no read-only mode: bind the key to this machine's IP when
# you create it, and keep only trading money in the account it belongs to.
COINDCX_API_KEY=
COINDCX_API_SECRET=

# More CoinDCX accounts: add a name after the key names (a-z, 0-9, _). This one
# is the account "second": `trade ... --account second`, and the Trade page's
# account picker. Bind each key to this machine's IP too.
# COINDCX_API_KEY_SECOND=
# COINDCX_API_SECRET_SECOND=
