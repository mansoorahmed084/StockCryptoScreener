# Copy to ~/screener-secrets/.env on the VM and fill in. Never commit the
# filled file. CoinDCX keys are bound to an IP: create NEW keys for the VM's
# public IP (the laptop's keys answer 401 from anywhere else).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
COINDCX_API_KEY=
COINDCX_API_SECRET=
COINDCX_API_KEY_SEHE=
COINDCX_API_SECRET_SEHE=
